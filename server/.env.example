# Suporte CA3 — Backend .env
# Copie para .env e ajuste os valores.

# Banco de dados (PostgreSQL via Docker)
DATABASE_URL="postgresql://CA3:745296@localhost:5432/CA3"

# Redis (BullMQ — filas de notificações, entregas e realtime)
REDIS_URL="redis://localhost:6379"

# Segredo JWT (gerar com: openssl rand -hex 64)
JWT_SECRET="troque-este-segredo"

# Porta do servidor
PORT=4000

# Token para validação do webhook do WhatsApp
WEBHOOK_TOKEN="troque-este-token"

# Origem permitida pelo CORS (frontend)
FRONTEND_URL="http://localhost:5173"
